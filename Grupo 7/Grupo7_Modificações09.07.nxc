/* Este c�digo funciona de maneira que o rob� possa se movimentar atrav�s dos motores A e C
Gire no pr�prio eixo para a esquerda com 50% da pot�ncia at� que identifique um advers�rio a menos de 35cm.
Uma vez identificado, o rob� andar� para frente em velocidade m�xima at� que a luta acabe ou ele perca o advers�rio de vista.

O intuito do desafio � adaptar o c�digo ao rob� de voc�s, adicionar movimenta��o inicial na fun��o pr� definida e realizar ajustes
na velocidade dos motores conforme forem necess�rios

Os comandos b�sicos s�o:

OnFwd(MOTOR, POTENCIA (0 a 100));
delay(milisegundos);

La�os s�o os comuns de C, while, for, do while, until.

Condicionais if, else if, else, switch case.

Para outras fun��es, tasks, structures ou condicionamentos especiais, procurar ajuda na staff do est�gio */

//==============================================================================
//==============================================================================
//==============================================================================

/* Ordem de montagem:

Motor da Direita na porta A
Motor da Arma ou desarme na porta B
Motor da Esquerda na porta C
Sensor na porta 1
Qualquer outra condi��o ou ideia, buscar apoio dos membros da equipe para configura��o
*/

//==============================================================================
//==============================================================================
//==============================================================================

//__________N�O MEXER SEM APOIO DA STAFF_______________________________________
#define motorEsquerdo OUT_A         // Motor Esquerdo                --> entrada A
#define motorArma OUT_B             // Poss�vel motor de Arma       --> entrada B
#define motorDireito OUT_C          // Motor Direito                 --> entrada C
#define distancia_sensor_1  (IN_1)  // Sensor Ultrass�nico Esquerdo --> entrada 1
#define distancia_sensor_4  (IN_4)  // Sensor Ultrass�nico Direito  --> entrada 4
void arma();
void movimentoInicial();
void movimentoBusca();




//__________MEXER PARA REGULAR A DISTANCIA DE BUSCA____________________________________
#define distancia_busca 40      // Limiar para o rob� come�ar a andar para frente, em cent�metros






//==============================================================================
//=========================CORPO DO C�DIGO======================================
//==============================================================================

task main(){

    SetSensorLowspeed(IN_1);            // N�O MEXER SUJEITO � >>>PROBLEMAS<<<
    SetSensorLowspeed(IN_4);            // N�O MEXER SUJEITO � >>>PROBLEMAS<<<
    Wait(5000);                         // Tempo de espera previsto nas regras

    arma();                             // Apagar o "//" caso seu rob� tenha motor para arma/desarme
    //movimentoInicial();               // Apagar o "//" para que seu rob� execute a estrat�gia inicial

    while(true){                                        //Rodar para sempre

        if(distancia_sensor1 < distancia_busca){        // Se o sensor1 est� vendo menos do que o definido como limiar
            if(distancia_sensor4 < distancia_busca){    // Se o sensor4 tambem est� vendo menos do que o definido como limiar, v� para frente
                OnFwd(motorDireita,100);                // Se o seu rob� for para tr�s, apenas inverter o sinal para "-100";
                OnFwd(motorEsquerda,100);               // Se o seu rob� for para tr�s, apenas inverter o sinal para "-100";
            }                                           // Se est� vendo ambos, sensor1 e sensor4

            else{                                       // Se o sensor4 N�O est� vendo menos do que o definido como limiar, fazer curva na dire��o do sensor1
                OnFwd(motorDireita,100);                // Se o seu rob� for para tr�s, inverta o sinal da pot�ncia
                OnFwd(motorEsquerda,75);                // Diminua ou aumente a pot�ncia para curvas mais r�pidas ou devagar.
            }                                           // Se est� vendo apenas o sensor1 e N�O o sensor4
        }

        else{                                           // Se o sensor1 N�O est� vendo menos do que o definido como limiar
            if(distancia_sensor4 < distancia_busca){    // Se o sensor4 est� vendo menos do que o definido como limiar, fazer curva na dire��o do sensor4
                OnFwd(motorDireita,75);                 // Se o seu rob� for para tr�s, apenas inverter o sinal para "-100";
                OnFwd(motorEsquerda,100);               // Diminua ou aumente a pot�ncia para curvas mais r�pidas ou devagar.
            }                                           // Se est� vendo apenas o sensor4 e N�O o sensor1

            else{                                       // Se o sensor4 N�O est� vendo menos do que o definido como limiar
                    movimentoBusca()                    // Procura o rob� inimigo
            }                                           // Se N�O est� vendo nenhum sensor
        }
    }
}

void arma()                     // Fun��o para a ativa��o de uma poss�vel arma
{
     OnFwd(motorArma,-100);     // Se o desarme for para a dire��o contr�ria, inverter sinal. Mexer na pot�ncia.
     Wait(250);                 // Se n�o desarmar completo, aumentar o delay;
     Off(motorArma);            // Uma vez que as linhas acabarem, o rob� ir� para a fun��o de movimentoInicial ou voltar para a main.
}

void movimentoInicial()
{
   // Se o seu rob� for para tr�s, apenas inverter o sinal para "-100";
   // Esta fun��o � a movimenta��o que o seu rob� far� quando os 5s acabarem, andar na diagonal, ir ret�o, dar r� ou girar.
   // Tudo que voc�s puderem fazer ser� �til, hoje nossos rob�s atuam com 9 a 26 estrat�gias *para cada lado*
   // Uma vez que as linhas de c�digo aqui acabarem, o rob� voltar� de onde parou, come�ando o while(true) das buscas.
}

void movimentoBusca()
{
   OnFwd(motorDireita,100);                 // Se o seu rob� for para tr�s, apenas inverter o sinal para "-100";
   OnFwd(motorEsquerda,-50);                // Esta fun��o � a movimenta��o que o seu rob� far� se N�O encontrar o advers�rio, girar.
}
